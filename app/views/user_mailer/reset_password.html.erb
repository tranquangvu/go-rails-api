<div style="max-width: 600px; margin: 0 auto; background: #fff; border-radius: 8px; padding: 20px;">
  <div style="margin-bottom: 20px; color: #000;">
    You are receiving this email because we received a password reset request for your account.
  </div>

  <%= link_to "Reset Password", @reset_password_url, style: "background: #000; color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block;" %>

  <div style="color: #000; margin-top: 20px;">
    If you're having trouble clicking the "Reset Password" button, copy and paste the URL below into your web browser:&nbsp;
    <%= link_to @reset_password_url, @reset_password_url %>
  </div>

  <div style="color: #666; margin-top: 20px; font-size: 14px;">
    This password reset link will expire in 15 minutes.<br>
    If you did not request a password reset, no further action is required.
  </div>
</div>
